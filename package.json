{
  "name": "workout_logging",
  "version": "1.0.0",
  "description": "Workout Logging API: log sets, browse history, track personal records",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "migrate": "node dist/db/migrate.js",
    "start:dev": "npm run build && npm run migrate && npm start",
    "test": "jest",
    "test:unit": "jest src",
    "test:e2e": "jest test --runInBand",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thinhngtruong/workout_logging.git"
  },
  "author": "Thinh Nguyen",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/thinhngtruong/workout_logging/issues"
  },
  "homepage": "https://github.com/thinhngtruong/workout_logging#readme",
  "dependencies": {
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/platform-express": "^11.2.11",
    "decimal.js": "^10.6.0",
    "js-yaml": "^5.5.0",
    "kysely": "^0.27.6",
    "nestjs-pino": "^5.3.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.11",
    "@testcontainers/postgresql": "^12.2.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "supertest": "^7.3.2",
    "testcontainers": "^12.2.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "testRegex": "\\.(spec|e2e-spec)\\.ts$",
    "testTimeout": 120000
  }
}
